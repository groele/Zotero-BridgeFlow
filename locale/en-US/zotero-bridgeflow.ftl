zbf-prefs-title = Zotero BridgeFlow
zbf-prefs-version = Version v{ $version }
zbf-prefs-footer = Zotero BridgeFlow · Seamless bridge between reading and writing · Zotero 10–12

zbf-card-overview-title = 1. Core Modules & Cross-Domain Fusion
zbf-card-overview-desc = Enable or disable the Workspace, Inspector, and Word Citation subsystems and configure deep cross-module linkages.
zbf-pref-mod-workspace = Enable Reading Workspace (horizontal/vertical tab groups, pin/sleep/virtual tabs, sessions & Spotlight)
zbf-pref-mod-inspector = Enable Inspector Center (live CSL preview, citation reverse lookup, side-by-side PDF preview & folder jump)
zbf-pref-mod-wordcite = Enable Word Citation Tracking (Citation column, drag-to-cite, temporary collections & managed tags)
zbf-fusion-section-title = Cross-Module Intrinsic Linkages:
zbf-pref-fusion-copy-history = Record copied citations from all entry points into local reverse-lookup history
zbf-pref-fusion-sidebar-badge = Show live active Word citation ordinal badges (e.g. [1]) in the vertical tab sidebar
zbf-pref-fusion-spotlight = Fuse active Word citations and clipboard reverse lookup into Spotlight (Ctrl+P / Cmd+P)
zbf-pref-fusion-lookup-jump = Prefer focusing an already-open tab when opening a reverse-lookup match

zbf-card-workspace-title = 2. Reading Workspace & Tab Lifecycle
zbf-card-workspace-desc = Configure dual-mode tab layouts, three-state lifecycle, and workspace snapshots.
zbf-pref-ws-horizontal = Enable top Edge-style horizontal colored tab groups
zbf-pref-ws-vertical = Enable resizable left vertical tab sidebar
zbf-pref-ws-pinned = Enable pinned tabs (close & sleep protection)
zbf-pref-ws-sleep = Enable reader tab sleep and memory release
zbf-pref-ws-virtual = Preserve virtual members when closing grouped tabs
zbf-pref-ws-spotlight = Enable global Spotlight command palette (Ctrl+P / Cmd+P)
zbf-pref-ws-sessions = Enable unified workspace sessions and rolling snapshots

zbf-card-inspector-title = 3. Inspector, Citation Lookup & PDF Compare
zbf-card-inspector-desc = Unified controls for all 4 right-hand item pane sections and local citation cache.
zbf-pref-ins-csl-enable = Enable live CSL citation & bibliography preview
zbf-pref-ins-what-to-show = Preview content
zbf-opt-show-both = Both in-text citation and bibliography
zbf-opt-show-cite = In-text citation only
zbf-opt-show-bib = Bibliography only
zbf-pref-ins-lookup-enable = Enable compact citation reverse lookup section
zbf-pref-ins-lookup-history = Persist local copied citation history for instant reverse lookup
zbf-pref-ins-pdf-preview = Enable right-hand PDF instant preview & same-item compare
zbf-pref-ins-pdf-folder = Enable right-hand one-click PDF folder icon

zbf-card-wordcite-title = 4. Word Citation Tracking & Governance
zbf-card-wordcite-desc = Configure Microsoft Word multi-document tracking, drag-to-cite, temporary collections, and citation tags.
zbf-pref-wc-drag = Enable Windows native drag-and-drop to insert editable Word CSL citations
zbf-pref-wc-collections = Maintain Word temporary collections in My Library (pinned above My Publications)
zbf-pref-wc-tags = Automatically maintain citation tags for items cited in active Word documents
zbf-pref-wc-tag-text = Citation tag text

zbf-card-diagnostics-title = 5. Diagnostics & Maintenance
zbf-card-diagnostics-desc = Manage debug logging, clear citation caches, or restore default settings.
zbf-pref-debug = Enable verbose debug logging (Zotero Debug Output)
zbf-btn-clear-cache = Clear all in-memory and local citation caches
zbf-btn-reset-defaults = Restore default settings

zbf-pane-csl-preview-title = BridgeFlow Citation Preview
zbf-pane-lookup-title = BridgeFlow Citation Lookup
zbf-pane-pdf-preview-title = BridgeFlow PDF Preview
zbf-pane-pdf-folder-title = Open PDF Folder
zbf-col-citation-title = Citation
